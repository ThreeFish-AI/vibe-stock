<?xml version="1.0" encoding="UTF-8"?>
<!-- vibe-stock 信号后验收盘评估 LaunchAgent 模板（references/05-postmortem.md
     「收盘后评估节奏」；I-022）。安装：
     1) 替换三类占位：__UV_PATH__ = `command -v uv` 绝对路径（launchd 不继承
        shell PATH）；__SK_PATH__ = 本仓 clone 绝对路径；__HOME__ = 家目录；
     2) mkdir -p __HOME__/.vibe-stock/postmortem/logs（launchd 不建日志父目录）；
     3) 复制到 ~/Library/LaunchAgents/ 后 launchctl bootstrap gui/$(id -u) <路径>。
     语义：周一至周五 17:50 单槽全量评估到期 pending 信号（signals.json →
     evaluated，经验面/绩效因子的唯一数据源）；与 outlook 17:35 槽错峰 15
     分钟（outlook 批量持锁 4–7 分钟，FetchLock 无重叠窗；评估取当日到期股
     日 K，预算≈到期股数条链，如实计入诊股熔断账本）。一次性命令：跑完即
     退、无 KeepAlive（失败不重拉——到期样本次日槽位补评，I-016 到期收盘
     门天然幂等）；节假日误拉一次无害（无到期信号即零评估零取数）。
     RunAtLoad=false：只靠日历槽不做投机拉起；注释内不写连续连字符（标准
     XML 可解析）。使用纪律（I-005）：17:30–18:10 勿并发跑 report——
     signals.json 读改写尚无文件锁，时段分离是现行防线。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.threefish.vibestock.postmortem</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>--no-project</string>
        <string>--with</string>
        <string>akshare==1.20.*</string>
        <string>--with</string>
        <string>efinance</string>
        <string>--with</string>
        <string>yfinance</string>
        <string>__SK_PATH__/scripts/postmortem.py</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardErrorPath</key>
    <string>__HOME__/.vibe-stock/postmortem/logs/postmortem.err.log</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.vibe-stock/postmortem/logs/postmortem.out.log</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>50</integer>
            <key>Weekday</key>
            <integer>1</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>50</integer>
            <key>Weekday</key>
            <integer>2</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>50</integer>
            <key>Weekday</key>
            <integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>50</integer>
            <key>Weekday</key>
            <integer>4</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>17</integer>
            <key>Minute</key>
            <integer>50</integer>
            <key>Weekday</key>
            <integer>5</integer>
        </dict>
    </array>
    <key>ThrottleInterval</key>
    <integer>600</integer>
</dict>
</plist>
