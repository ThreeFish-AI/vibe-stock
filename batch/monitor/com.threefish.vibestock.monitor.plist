<!-- vibe-stock 盯盘 LaunchAgent 模板（P1；0.0.16 补拉槽，I-009）。安装步骤见
     batch/monitor/README.md：
     1) 替换三类占位：__UV_PATH__ = `command -v uv` 的绝对路径（launchd 不继承
        shell PATH，默认只有 /usr/bin:/bin:/usr/sbin:/sbin）；__SK_PATH__ = 本仓
        clone 绝对路径；__HOME__ = 家目录（日志两处）；
     2) mkdir -p __HOME__/.vibe-stock/monitor/logs（launchd 不建日志父目录）；
     3) 复制到 ~/Library/LaunchAgents/ 后 launchctl bootstrap gui/$(id -u) <路径>。
     语义（references/07-monitor.md「宿主形态」）：周一至周五 09:15 主槽拉起
     watch.py 常驻轮询；交易时段补拉槽（09:45 至 11:45、13:15 至 15:45 各每
     30min 一槽，覆盖 A 股与港股交易时段，两市共同休市窗 12:00 至 13:00 不设
     槽）兜底当日中断：重启/开机/重新登录/进程被杀后最迟 30min 由下一槽补拉
     （launchd 对关机/重启期间错过的日历触发不补发、睡眠唤醒合并补发一次；
     进程运行期间槽位被直接丢弃，不并发、退出后也不排队）；16:15 盘后槽
     兜底当日收盘复核
     （close_done 未置则补跑，已置则立即退出）。节假日由快照日期守卫停轮
     兜底；KeepAlive.Crashed 只认信号级崩溃：watch.py 把常驻模式的 Python
     未捕获异常转为 SIGABRT 才能自愈；正常收口 exit 0 与重复实例 exit 3
     不重拉。RunAtLoad=false 且 AfterInitialDemand=true：补拉只靠日历槽，
     不做投机拉起（I-008；注释内不写连续连字符，保持标准 XML 可解析）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.threefish.vibestock.monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>--no-project</string>
        <string>--with</string>
        <string>akshare==1.20.*</string>
        <string>--with</string>
        <string>efinance</string>
        <string>--with</string>
        <string>yfinance</string>
        <string>__SK_PATH__/batch/monitor/watch.py</string>
        <string>--loop</string>
    </array>

