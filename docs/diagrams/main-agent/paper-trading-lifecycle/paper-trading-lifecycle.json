    { "id": "t3", "from": "tranche", "to": "holding", "label": "任一批成交", "variant": "emphasis", "fromSide": "right", "toSide": "bottom" },
    { "id": "t4", "from": "tranche", "to": "expired", "label": "所有批均 expired", "fromSide": "bottom", "toSide": "top" },
    { "id": "t5", "from": "tranche", "to": "hk", "label": "新鲜度未过闸", "variant": "dashed", "fromSide": "right", "toSide": "left" },
    { "id": "t6", "from": "hk", "to": "holding", "label": "收盘复核成交", "fromSide": "top", "toSide": "bottom" },
    { "id": "t7", "from": "holding", "to": "closed", "label": "止盈止损 / 人工清仓", "fromSide": "bottom", "toSide": "top" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "三批并行状态机",
      "items": [
        "T1_open 次日开盘批：按开盘价成交；跳空 >+2% 转限价（信号日收盘×1.02、5 日 GTC，未穿价 expired）",
        "T2_limit 限价批：low<limit 严格穿价 · 成交价=min(open, entry_ref) · 触价写回经用户逐笔确认 record_fill",
        "T3_trigger 确认批：触发条件确认后才计成交；各批独立 pending→filled/expired，任一批成交即进 holding（余批继续 pending）；T3 补足必转 filled，仅无 T3 批（≤2 手）才会全部 expired"
      ]
    },
    {
      "dot": "amber",
      "title": "holding 内嵌约束",
      "items": [
        "T+1 可卖份额日切清零；涨跌停三态：一字板不可成交",
        "停牌冻结，复牌按实际开盘处理；公司行动先送转后分红 + 分档红利税",
        "滑点静态表：A股 5–10bp；港股按最小价位分档"
      ]
    },
    {
      "dot": "rose",
      "title": "红线 NR-2",
      "items": [
        "永不接真实下单接口：全程只写 sim-portfolio.json（07 P3 schema）",
        "港股标的时戳新鲜度门禁未过闸 → 回落收盘复核成交（虚线分支），不做盘中追价",
        "触价写回必须经用户逐笔确认，无人工确认不记账"
      ]
    }
  ]
}
