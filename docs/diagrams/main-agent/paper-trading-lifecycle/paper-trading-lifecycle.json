  ],
  "states": [
    { "id": "alloc", "type": "start", "label": "allocation 导入", "sublabel": "06 Stage D · 三段建仓", "tag": "NR-2 纯模拟", "lane": "main", "col": 0, "step": "01" },
    { "id": "pend", "type": "waiting", "label": "pending_open", "sublabel": "预算·标的校验 · 待次日开盘", "lane": "main", "col": 1, "step": "02" },
    { "id": "holding", "type": "active", "label": "holding", "sublabel": "持仓运行 · 约束内", "tag": "五约束见卡片", "lane": "main", "col": 3, "step": "04" },
    { "id": "tranche", "type": "waiting", "label": "tranche 三批并行", "sublabel": "T1_open / T2_limit / T3_trigger", "tag": "各批 pending→filled/expired", "lane": "tranche", "col": 2, "step": "03" },
    { "id": "hk", "type": "waiting", "label": "港股收盘复核", "sublabel": "15:10 / 16:10 --close", "tag": "回落成交", "lane": "tranche", "col": 3 },
    { "id": "expired", "type": "failure", "label": "建仓失败", "sublabel": "所有存在的批均 expired · 无持仓", "lane": "terminal", "col": 2 },
    { "id": "closed", "type": "success", "label": "closed", "sublabel": "清仓 · 全部了结", "lane": "terminal", "col": 4 }
